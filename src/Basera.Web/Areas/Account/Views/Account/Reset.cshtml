@model ResetPasswordInput
@{
    ViewData["Title"] = T["Account.Reset.Title"].Value;
}

<h1 class="h4 mb-1">@T["Account.Reset.Title"]</h1>
<p class="text-body-secondary mb-4">@T["Account.Reset.Lead"]</p>

<form method="post" asp-action="Reset" novalidate>
    <partial name="_FormErrors" />
    <div class="mb-3">
        <label asp-for="Phone" class="form-label">@T["Account.Phone"]</label>
        <input asp-for="Phone" type="tel" inputmode="tel" class="form-control form-control-lg" autocomplete="tel" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Code" class="form-label">@T["Account.Code"]</label>
        <input asp-for="Code" inputmode="numeric" pattern="[0-9]*" maxlength="6" class="form-control form-control-lg otp-input" autocomplete="one-time-code" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <label asp-for="NewPassword" class="form-label">@T["Account.Reset.NewPassword"]</label>
        <input asp-for="NewPassword" type="password" class="form-control form-control-lg" autocomplete="new-password" />
        <div class="form-text">@T["Account.PasswordRules"]</div>
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">@T["Account.Reset.Submit"]</button>
</form>

<div class="d-flex justify-content-between flex-wrap gap-2 mt-4">
    <a asp-action="Forgot">@T["Account.Reset.Resend"]</a>
    <a asp-action="Login">@T["Account.Back"]</a>
</div>
