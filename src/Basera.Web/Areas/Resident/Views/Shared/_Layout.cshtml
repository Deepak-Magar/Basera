<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <partial name="_Head" />
</head>
<body class="has-bottom-bar" hx-headers='@Html.HtmxAntiforgeryHeaders()'>
    <header class="navbar bg-primary" data-bs-theme="dark">
        <div class="container">
            <span class="navbar-brand fw-semibold">Basera · Resident</span>
            <div class="d-flex align-items-center gap-2 ms-auto">
                <partial name="_UserMenu" />
                <partial name="_LanguageSwitch" />
            </div>
        </div>
    </header>
    <main class="container py-3">
        @RenderBody()
    </main>
    <nav class="bottom-bar fixed-bottom bg-body border-top">
        <div class="container d-flex">
            <a class="flex-fill d-flex align-items-center justify-content-center text-decoration-none"
               asp-area="Resident" asp-controller="Home" asp-action="Index">@T["Shared.Home"]</a>
        </div>
    </nav>
    <partial name="_Scripts" />
</body>
</html>
