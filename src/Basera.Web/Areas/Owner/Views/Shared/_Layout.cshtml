<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <partial name="_Head" />
</head>
<body hx-headers='@Html.HtmxAntiforgeryHeaders()'>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand fw-semibold" asp-area="Owner" asp-controller="Home" asp-action="Index">Basera · Owner</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-area="Owner" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="nav-link" href="/owner/staff">@T["Owner.Staff.Title"]</a>
            </div>
            <div class="d-flex align-items-center gap-2 ms-auto">
                <partial name="_UserMenu" />
                <partial name="_LanguageSwitch" />
            </div>
        </div>
    </nav>
    <main class="container-fluid py-4">
        @RenderBody()
    </main>
    <partial name="_Scripts" />
</body>
</html>
