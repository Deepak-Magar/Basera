<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Basera.Shared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- IEndpointRouteBuilder, IServiceCollection, IConfiguration. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- TenantDbContext, interceptors and conventions every module DbContext inherits. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Data Protection key ring in the "dataprotection" schema (ARCHITECTURE §6, §12). -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <!-- Input validation through an MVC filter that fills ModelState (ADR-008). -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- Background jobs (ADR-006): storage in the "hangfire" schema, dashboard at /jobs. -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Domain\Calendar\calendar-bs.csv" LogicalName="Basera.Shared.calendar-bs.csv" />
  </ItemGroup>

</Project>
